<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Light is the default qualifier and dark lives in values-night, so the
        window matches the Compose scheme before the first frame and the cold
        start does not flash the wrong ground under it.
    -->
    <style name="Theme.InsertaBot" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!--
        Cold start shows the Mistyk Media mark on the app's own background
        (light or dark, per values-night), then hands over to Theme.InsertaBot
        with no colour change. The launch theme is only ever on screen before
        the first frame, so it carries no app styling of its own.
    -->
    <style name="Theme.InsertaBot.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.InsertaBot</item>
    </style>
</resources>
