<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.InsertaBot" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!--
        Cold start shows the robot on the art's own dark ground, then hands over
        to Theme.InsertaBot. The launch theme is only ever on screen before the
        first frame, so it carries no app styling of its own.
    -->
    <style name="Theme.InsertaBot.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.InsertaBot</item>
    </style>
</resources>
