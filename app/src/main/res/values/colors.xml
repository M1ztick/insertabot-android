<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher icon ground. White, as the Mistyk Media mark is drawn on. -->
    <color name="ic_launcher_background">#FFFFFF</color>

    <!-- Splash ground: the same as the window it hands over to (LightColors /
         DarkColors background in Theme.kt), so cold start never changes colour.
         values-night overrides both. -->
    <color name="splash_background">#F5FAF8</color>

    <!-- Matches LightColors.background in Theme.kt. Set as windowBackground so
         the hand-off from the splash screen does not flash a stock grey. -->
    <color name="window_background">#F5FAF8</color>
</resources>
