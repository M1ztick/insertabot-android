<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the Material 3 dark primaryContainer the app renders with. -->
    <color name="ic_launcher_background">#381E72</color>

    <!-- The darkest navy in the logo art, so the icon's faded edges have
         nothing to sit against but their own background. -->
    <color name="splash_background">#150C33</color>

    <!-- Matches LightColors.background in Theme.kt; values-night overrides it
         with the dark ground. Set as windowBackground so the hand-off from the
         splash screen does not flash a stock grey. -->
    <color name="window_background">#FFF7FB</color>
</resources>
